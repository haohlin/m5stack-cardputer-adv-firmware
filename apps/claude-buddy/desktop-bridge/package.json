{
  "name": "claude-cardputer-bridge",
  "version": "0.1.0",
  "description": "Local MCPB bridge for Claude Desktop and M5Stack Cardputer ADV",
  "type": "module",
  "bin": {
    "claude-cardputer-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pair-config": "node dist/index.js --write-pairing-config ../release/bridge-config",
    "pack:mcpb": "npm run build && mcpb pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.20.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}

